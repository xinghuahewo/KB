#!/usr/bin/env python3
"""检查或一致性备份独立会话 SQLite 数据库。"""

from __future__ import annotations

import argparse
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import re
import sqlite3
import sys
from typing import Any
from urllib.parse import quote
import uuid


SUPPORTED_SCHEMA_VERSION = 1
REQUIRED_TABLES = frozenset(
    {
        "conversations",
        "messages",
        "message_evidence",
        "turn_requests",
    }
)
TIMESTAMP_PATTERN = re.compile(r"^[0-9]{8}T[0-9]{6}Z$")


def _read_only_uri(path: Path) -> str:
    return f"file:{quote(str(path), safe='/')}?mode=ro"


def inspect_database(database: Path) -> dict[str, Any]:
    selected = database.expanduser().resolve()
    result: dict[str, Any] = {
        "ok": False,
        "database_path": str(selected),
        "database_exists": selected.is_file(),
        "writable": selected.is_file() and os.access(selected, os.W_OK),
        "integrity_check": None,
        "schema_version": None,
        "schema_compatible": False,
        "required_tables_present": False,
    }
    if not result["database_exists"]:
        result["error"] = "database_missing"
        return result

    try:
        with sqlite3.connect(_read_only_uri(selected), uri=True, timeout=5.0) as connection:
            integrity_rows = [
                str(row[0]) for row in connection.execute("PRAGMA integrity_check").fetchall()
            ]
            result["integrity_check"] = (
                "ok" if integrity_rows == ["ok"] else "; ".join(integrity_rows)
            )
            result["schema_version"] = int(
                connection.execute("PRAGMA user_version").fetchone()[0]
            )
            tables = {
                str(row[0])
                for row in connection.execute(
                    "SELECT name FROM sqlite_master WHERE type = 'table'"
                ).fetchall()
            }
    except (OSError, sqlite3.Error, TypeError, ValueError) as exc:
        result["error"] = f"{type(exc).__name__}: {exc}"
        return result

    missing_tables = sorted(REQUIRED_TABLES - tables)
    result["required_tables_present"] = not missing_tables
    if missing_tables:
        result["missing_tables"] = missing_tables
    result["schema_compatible"] = result["schema_version"] == SUPPORTED_SCHEMA_VERSION
    result["ok"] = bool(
        result["writable"]
        and result["integrity_check"] == "ok"
        and result["schema_compatible"]
        and result["required_tables_present"]
    )
    return result


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def _remove_temporary_database(path: Path) -> None:
    for candidate in (
        path,
        path.with_name(f"{path.name}-wal"),
        path.with_name(f"{path.name}-shm"),
    ):
        candidate.unlink(missing_ok=True)


def backup_database(database: Path, target: Path) -> dict[str, Any]:
    source = database.expanduser().resolve()
    destination = target.expanduser().resolve()
    source_status = inspect_database(source)
    if not source_status["ok"]:
        raise RuntimeError("源会话数据库未通过存在性、可写性、完整性、schema 或表结构检查。")

    backup_directory = destination.parent
    if backup_directory.exists() and backup_directory.is_symlink():
        raise RuntimeError("备份目录不得是符号链接。")
    backup_directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(backup_directory, 0o700)
    if destination.exists() or destination.is_symlink():
        raise FileExistsError(f"备份目标已存在：{destination}")

    temporary = backup_directory / f".{destination.name}.tmp-{os.getpid()}-{uuid.uuid4().hex}"
    try:
        with sqlite3.connect(_read_only_uri(source), uri=True, timeout=5.0) as source_connection:
            with sqlite3.connect(temporary, timeout=5.0) as backup_connection:
                source_connection.backup(backup_connection)
        os.chmod(temporary, 0o600)

        backup_status = inspect_database(temporary)
        if not backup_status["ok"]:
            raise RuntimeError("临时备份未通过完整性、schema 或表结构检查。")
        size_bytes = temporary.stat().st_size
        digest = _sha256(temporary)

        try:
            os.link(temporary, destination)
        except FileExistsError as exc:
            raise FileExistsError(f"备份目标已存在：{destination}") from exc
        temporary.unlink()
        os.chmod(destination, 0o600)
    except Exception:
        _remove_temporary_database(temporary)
        raise

    return {
        "ok": True,
        "backup_path": str(destination),
        "size_bytes": size_bytes,
        "sha256": digest,
        "schema_version": backup_status["schema_version"],
        "schema_compatible": backup_status["schema_compatible"],
        "integrity_check": backup_status["integrity_check"],
        "required_tables_present": backup_status["required_tables_present"],
    }


def _default_timestamp() -> str:
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def _backup_target(args: argparse.Namespace) -> Path:
    if args.output:
        return args.output
    timestamp = args.timestamp or _default_timestamp()
    if not TIMESTAMP_PATTERN.fullmatch(timestamp):
        raise ValueError("timestamp 必须使用 YYYYMMDDTHHMMSSZ。")
    return args.backup_dir / f"chat_history-{timestamp}.sqlite3"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    inspect_parser = subparsers.add_parser("inspect", help="只读检查会话数据库。")
    inspect_parser.add_argument("--database", required=True, type=Path)

    backup_parser = subparsers.add_parser("backup", help="创建一致性、不可覆盖的会话备份。")
    backup_parser.add_argument("--database", required=True, type=Path)
    backup_parser.add_argument("--backup-dir", type=Path, default=Path("/srv/bgpkb/backups/chat"))
    backup_parser.add_argument("--output", type=Path)
    backup_parser.add_argument("--timestamp")

    args = parser.parse_args()
    if args.command == "inspect":
        result = inspect_database(args.database)
        print(json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True))
        return 0 if result["ok"] else 1

    try:
        result = backup_database(args.database, _backup_target(args))
    except (FileExistsError, OSError, RuntimeError, sqlite3.Error, ValueError) as exc:
        print(f"会话数据库备份失败：{exc}", file=sys.stderr)
        return 1
    print(json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
